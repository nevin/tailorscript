{
  "name": "tailorscript",
  "version": "0.5.0",
  "private": true,
  "description": "Tailor websites with your own JavaScript. A private userscript manager for Chrome.",
  "type": "module",
  "engines": {
    "node": ">=22.2"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "vendor": "node scripts/vendor.mjs",
    "lint": "eslint .",
    "test": "node --test --experimental-test-coverage --test-coverage-include=\"src/**\" --test-coverage-exclude=\"src/vendor/**\" --test-coverage-lines=80 --test-coverage-branches=80 --test-coverage-functions=85 \"tests/**/*.test.mjs\"",
    "verify": "npm run lint && npm run typecheck && npm test && npm run check",
    "package": "node scripts/package.mjs",
    "release": "npm run verify && npm run package",
    "submit": "node scripts/submit.mjs",
    "version": "node scripts/sync-version.mjs",
    "harness": "node scripts/harness.mjs",
    "typecheck": "tsc -p .",
    "vendor:check": "node scripts/vendor.mjs --check",
    "dev": "node scripts/dev.mjs",
    "test:e2e": "node --test tests/e2e/extension.e2e.mjs"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.8",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@eslint/js": "^10.0.1",
    "@lezer/highlight": "^1.2.5",
    "@types/chrome": "^0.3.7",
    "acorn": "^8.19.0",
    "codemirror": "^6.0.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "puppeteer": "^25.17.0",
    "typescript": "^5.9.3"
  }
}
