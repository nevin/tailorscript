# Chrome Web Store API credentials for `npm run submit`. Copy to .env (which git ignores) and fill in.
# See docs/publishing.md for how to create each value.
CWS_CLIENT_ID=
CWS_CLIENT_SECRET=
CWS_REFRESH_TOKEN=
# Shown in the Developer Dashboard under Account; usually your developer account ID.
CWS_PUBLISHER_ID=
# The 32-character item ID from the extension's store listing URL.
CWS_EXTENSION_ID=
