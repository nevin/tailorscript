{
  "manifest_version": 3,
  "name": "Tailorscript – Userscript Manager",
  "short_name": "Tailorscript",
  "version": "0.6.0",
  "description": "Tailor websites with your own JavaScript. A private userscript manager that keeps scripts in your browser.",
  "minimum_chrome_version": "138",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "userScripts",
    "activeTab",
    "alarms",
    "notifications",
    "declarativeNetRequestWithHostAccess"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "Tailorscript",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "commands": {
    "toggle-pause": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Pause or resume all scripts"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "install/install.html"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
