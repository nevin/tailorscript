{
  "manifest_version": 3,
  "name": "Tailorscript – Userscript Manager",
  "short_name": "Tailorscript",
  "version": "0.4.0",
  "description": "Tailor websites with your own JavaScript. A private userscript manager that keeps scripts in your browser.",
  "minimum_chrome_version": "138",
  "permissions": [
    "storage",
    "userScripts",
    "activeTab"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "Tailorscript",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
